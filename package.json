{
  "name": "earthworm",
  "version": "1.0.0",
  "description": "Earthworm English learning app",
  "main": "index.js",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=client",
    "build": "npm run build --workspace=client",
    "dev:client": "npm run dev --workspace=client",
    "dev:serve": "npm run schema:build && npm run start:dev --workspace=api",
    "schema:build": "npm run build --workspace=@earthworm/schema",
    "build:client": "npm run generate --workspace=client",
    "build:server": "npm run schema:build && npm run build --workspace=api",
    "test": "npm run test --workspace=client",
    "format": "prettier --write --cache .",
    "format-check": "prettier --check --cache ."
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=20.12.2"
  },
  "devDependencies": {
    "@headlessui/tailwindcss": "^0.2.2",
    "@ianvs/prettier-plugin-sort-imports": "^4.2.1",
    "@nuxtjs/tailwindcss": "^6.14.0",
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "@types/archiver": "^6.0.2",
    "@types/fs-extra": "^11.0.4",
    "@types/inquirer": "^9.0.7",
    "@types/node": "^20.12.7",
    "@types/semver": "^7.5.8",
    "archiver": "^7.0.1",
    "conventional-changelog-cli": "^4.1.0",
    "dotenv": "^16.3.1",
    "fs-extra": "^11.2.0",
    "inquirer": "^9.2.13",
    "lint-staged": "^15.2.2",
    "picocolors": "^1.0.1",
    "prettier": "^3.2.5",
    "prettier-plugin-tailwindcss": "0.5.13",
    "semver": "^7.6.3",
    "tsup": "^8.0.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "@t3-oss/env-core": "^0.7.1",
    "zod": "^3.22.4"
  }
}